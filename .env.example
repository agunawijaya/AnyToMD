# Pilih provider: anthropic (default, kualitas terbaik)
# Pilihan lain: openai (ChatGPT), gemini (Google), moonshot (Kimi), ollama (offline)
ANYTOMD_PROVIDER=anthropic

# --- Anthropic (default, kualitas terbaik untuk diagram info-dense) ---
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANYTOMD_MODEL=claude-sonnet-4-6

# --- OpenAI (ChatGPT) ---
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
ANYTOMD_OPENAI_MODEL=gpt-4o
# Optional base URL override (untuk Azure OpenAI atau proxy)
# OPENAI_BASE_URL=

# --- Google Gemini ---
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANYTOMD_GEMINI_MODEL=gemini-2.5-flash

# --- Moonshot (Kimi) — Chinese vision LLM, OpenAI-compatible API ---
# Get key: https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=
ANYTOMD_MOONSHOT_MODEL=moonshot-v1-32k-vision-preview
# Base URL: default api.moonshot.cn/v1. Ganti ke api.moonshot.ai/v1 kalau bukan CN.
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# --- Ollama (offline fallback / testing / graceful degradation) ---
# Peran: fallback ketika cloud provider quota/error, offline mode untuk dokumen
# sensitif, atau graceful degradation setelah COST_CAP tercapai. Kualitas VLM
# lokal 7B lebih rendah untuk diagram info-dense — untuk output terbaik pakai
# provider cloud. Pastikan `ollama serve` sudah jalan dan model sudah di-pull.
OLLAMA_HOST=http://localhost:11434
ANYTOMD_OLLAMA_MODEL=qwen2.5vl:7b

# --- Optimasi token AI (default: skip_decorative ON, sisanya OFF) ---
# Skip AI call kalau bytes gambar identik sudah pernah dianalisis di file ini.
# Nilai: 1/true/yes/on
ANYTOMD_IMAGE_DEDUP=false
# Skip AI call kalau sisi terpanjang gambar < N pixel. 0 = tanpa filter.
ANYTOMD_IMAGE_MIN_DIM=0
# Skip AI call kalau ukuran raw bytes < N. 0 = tanpa filter.
ANYTOMD_IMAGE_MIN_BYTES=0
# Skip gambar hiasan (solid color blob, gradient circle) via classifier lokal.
# Default: true — nyaris tidak pernah salah dan hemat 3-10 AI call per file.
ANYTOMD_SKIP_DECORATIVE=true
# Mode: all | diagrams_only | none
#   all           = kirim semua gambar (default)
#   diagrams_only = heuristik lokal, hanya gambar mirip diagram yang dikirim
#   none          = jangan pernah kirim gambar ke AI, hanya placeholder
ANYTOMD_IMAGE_MODE=all

# --- Hybrid image routing (Sprint 3) ---
# Untuk best-of-both-worlds: route per-jenis-gambar ke provider yg cocok.
# Contoh: diagram → Anthropic (kualitas), photo → Gemini (murah), fallback → Ollama.
# Tanpa opsi ini, semua image ikut ANYTOMD_PROVIDER.
#
# Setiap variabel menerima salah satu: anthropic, openai, gemini, moonshot, ollama
#   ANYTOMD_IMAGE_PROVIDER_FOR_DIAGRAM=anthropic
#   ANYTOMD_IMAGE_PROVIDER_FOR_CHART=anthropic
#   ANYTOMD_IMAGE_PROVIDER_FOR_SCREENSHOT=openai
#   ANYTOMD_IMAGE_PROVIDER_FOR_PHOTO=gemini
#
# Atau default untuk semua image (di-override oleh per-kind di atas):
#   ANYTOMD_IMAGE_PROVIDER=anthropic
#
# Budget cap dalam USD — kalau tercapai, sisa image di-downgrade ke Ollama
# (atau di-skip kalau Ollama tidak tersedia). 0 = tanpa cap.
ANYTOMD_COST_CAP_USD=0

# --- OCR untuk PDF scanned (hanya berlaku ke .pdf) ---
# Mode: never | auto | always
#   never   = jangan pernah OCR (default)
#   auto    = OCR hanya page yang tampak scan (text kosong + full-page image)
#   always  = OCR setiap page (paksa)
ANYTOMD_PDF_OCR=never
# Engine: tesseract | paddleocr | ai | hybrid
#   tesseract = offline, ringan, butuh Tesseract binary + pytesseract
#   paddleocr = offline, akurat, heavy (butuh `pip install paddleocr`)
#   ai        = pakai Anthropic/Ollama vision — mahal token
#   hybrid    = Tesseract dulu; kalau hasil kosong/kecil, fallback ke AI
ANYTOMD_OCR_ENGINE=tesseract
# Bahasa Tesseract (kode 3-huruf, gabungkan dengan +): ind+eng, eng, ind+eng+ara
ANYTOMD_OCR_LANG=ind+eng
# Optional: absolute path ke tesseract.exe kalau tidak ada di PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
